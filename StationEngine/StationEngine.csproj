<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>StationEngine</AssemblyName>
    <RootNamespace>Zeus.StationEngine</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Station.Engine.Hosting\Station.Engine.Hosting.csproj" />
    <ProjectReference Include="..\Zeus.Plugins.Host\Zeus.Plugins.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zeus.Server.Tests" />
  </ItemGroup>

  <!-- FORK: the TX plate reverb is plate_reverb.dll from the (private)
       poseidon-plate-reverb repository, loaded at runtime only if present.
       When a local build of it exists, copy it next to the engine; when it
       does not, as in a public clone, this is skipped and the engine simply
       reports the reverb as unavailable. Override with /p:PlateReverbDll=. -->
  <PropertyGroup>
    <PlateReverbDll Condition="'$(PlateReverbDll)' == ''">$(USERPROFILE)\poseidon-plate-reverb\dist\win-x64\plate_reverb.dll</PlateReverbDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(PlateReverbDll)')">
    <None Include="$(PlateReverbDll)" Link="plate_reverb.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
